<mjml owa="desktop">
  <mj-head>
    <mj-title>LumiTure.ai monitor</mj-title>
    <mj-font
      name="Noto Sans TC"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />
    <!-- global style -->
    <mj-attributes>
      <mj-include path="../common/global-style.mjml" />
    </mj-attributes>
    <mj-style>
      .mobile-padding { padding: 40px ; } .table tr { border-bottom: 1px solid #E6E6E6;}
      .summary-table { border-top: 1px solid #B3B3B3; border-bottom: 1px solid #B3B3B3; }
      .summary-table td {line-height: 1.75; padding: 8px 0px} .group-first-column { width:40%; padding-right: 16px; } .budget-first-column { width:50%;
      padding-right: 8px; }.cost-table th{background-color: #F3F7FA ;padding: 4px 16px; text-align:
      left ;font-weight:unset;}.cost-table td{line-height: 1.75;padding:4px 16px} @media
      (max-width:450px) { .mobile-padding { padding: 40px 20px ; } } .progress_bar-wrap { position:
      relative; } .progress_bar { border-radius: 4px; } .progress_bar > p { border-radius: 4px;
      border-color: #00B5A6 !important; {{#greaterThan threshold 30}} border-color: #F4A938
      !important; {{/greaterThan}} {{#greaterThan threshold 100}} border-color: #FF403D !important;
      {{/greaterThan}} }
    </mj-style>
  </mj-head>

  <mj-body width="600px" background-color="#F3F7FA">
    <!-- logo -->
    <mj-include path="../common/header.mjml" />

    <mj-wrapper background-color="#FFFFFF">
      <!-- header image -->
      <mj-include path="../common/alert-header.mjml" />

      <!-- content -->
      <mj-section padding="40px 40px 0px 40px">
        <!-- summary title -->
        <mj-column width="100%" padding-bottom="0px">
          <mj-text font-size="24px" font-weight="700" line-height="1.5" padding-bottom="0"
            >Anomalous Spendings Detected</mj-text
          >
        </mj-column>
      </mj-section>

      <mj-raw>{{#each anomalies}}</mj-raw>
      <mj-section css-class="mobile-padding" padding-top="0px" padding-bottom="0px">
        <!-- platform logo + resource info + view details -->
        <mj-column width="10%" vertical-align="middle" padding-right="0px">
          <mj-raw>{{#equals platform "gcp"}}</mj-raw>
          <mj-image
            align="left"
            width="40px"
            padding="0px"
            src="http://cdn.mcauto-images-production.sendgrid.net/ff6786561925730a/90472c80-1b48-4f74-b896-824de998f707/41x41.png"
          />
          <mj-raw>{{/equals}} {{#equals platform "aws"}}</mj-raw>
          <mj-image
            align="left"
            width="40px"
            padding="0px"
            src="http://cdn.mcauto-images-production.sendgrid.net/ff6786561925730a/1750afde-0103-42fe-b8a4-cb600d547569/41x41.png"
          />
          <mj-raw>{{/equals}} {{#equals platform "azure"}}</mj-raw>
          <mj-image
            align="left"
            width="40px"
            padding="0px"
            src="http://cdn.mcauto-images-production.sendgrid.net/dc12dd9095e5b7a8/ac0edfc7-840f-4c56-a3d0-10a8cb87fba3/40x40.png"
          />
          <mj-raw>{{/equals}}</mj-raw>
        </mj-column>
        <mj-column width="60%" vertical-align="middle" padding-left="16px">
          <mj-raw>{{#equals platform "gcp"}}</mj-raw>
          <mj-text line-height="1.75" padding="0px">Project Name / ID</mj-text>
          <mj-raw>{{/equals}} {{#equals platform "aws"}}</mj-raw>
          <mj-text line-height="1.75" padding="0px">Account Name / ID</mj-text>
          <mj-raw>{{/equals}} {{#equals platform "azure"}}</mj-raw>
          <mj-text line-height="1.75" padding="0px">Resource Group Name / ID</mj-text>
          <mj-raw>{{/equals}}</mj-raw>
          <mj-text
            font-size="16px"
            font-weight="700"
            line-height="1.5"
            padding="0px"
            padding-bottom="4px"
            >{{ resource_name }}</mj-text
          >
          <mj-text color="#676767" padding="0px" padding-bottom="20px">{{ resource_id }}</mj-text>
        </mj-column>
        <mj-column width="30%" vertical-align="middle" padding-right="0px">
          <mj-button
            align="right"
            width="130px"
            height="36px"
            border-radius="5px"
            background-color="transparent"
            color="#004FB0"
            border="1px solid #004FB0"
            font-size="14px"
            font-weight="700"
            inner-padding="8px 16px"
            padding="0px"
            href="{{detail_link}}"
          >
            View Details
          </mj-button>
        </mj-column>

        <mj-column width="100%">
          <mj-table css-class="table summary-table">
            <tr>
              <td class="group-first-column">Cost</td>
              <td style="font-weight: 700">{{ cost }}</td>
            </tr>
            <tr>
              <td class="group-first-column">Cost Date</td>
              <td style="font-weight: 700">{{ cost_date }}</td>
            </tr>
            <tr>
              <td class="group-first-column" style="vertical-align: top">Assigned to</td>
              <td>
                <ul style="padding-left: 20px; margin: 0px">
                  {{#each assign_to}}
                  {{#lessThan @index 5}}
                  <li>{{ this }}</li>
                  {{/lessThan}}
                  {{#equals @index 5}}
                  <li style="list-style: none; color: #b3b3b3">
                    ...more, view full list in detail page.
                  </li>
                  {{/equals}}
                  {{/each}}
                </ul>
              </td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>
      <mj-raw>{{/each}}</mj-raw>

      <mj-section padding-bottom="20px">
        <!-- action button -->
        <mj-column width="100%" padding="30px 0px">
          <mj-button
            width="246px"
            height="36px"
            border-radius="5px"
            background-color="#004FB0"
            color="white"
            font-size="16px"
            font-weight="700"
            line-height="24px"
            href="{{historical_anomalies_link}}"
          >
            See All Historical Anomalies
          </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- footer -->
    <mj-include path="../common/footer.mjml" />
  </mj-body>
</mjml>
