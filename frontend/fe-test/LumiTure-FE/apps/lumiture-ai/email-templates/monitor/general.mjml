<mjml owa="desktop">
  <mj-head>
    <mj-title>LumiTure.ai monitor</mj-title>
    <mj-font
      name="Noto Sans TC"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />
    <!-- global style -->
    <mj-attributes>
      <mj-include path="../common/global-style.mjml" />
    </mj-attributes>
    <mj-style>
      .mobile-padding {
        padding: 40px;
      }
      .table tr {
        border-bottom: 1px solid #e6e6e6;
      }
      .summary-table {
        border-top: 1px solid #b3b3b3;
        border-bottom: 1px solid #b3b3b3;
      }
      .summary-table td {
        line-height: 1.75;
        padding: 8px 0px;
      }
      .group-first-column {
        width: 50%;
        padding-right: 8px;
      }
      .cost-table th {
        background-color: #f3f7fa;
        padding: 4px 16px;
        text-align: left;
        font-weight: unset;
      }
      .cost-table td {
        line-height: 1.75;
        padding: 4px 16px;
      }
      @media (max-width: 450px) {
        .mobile-padding {
          padding: 40px 20px;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body width="600px" background-color="#F3F7FA">
    <!-- logo -->
    <mj-include path="../common/header.mjml" />

    <mj-wrapper background-color="#FFFFFF">
      <!-- header image -->
      <mj-include path="../common/alert-header.mjml" />

      <!-- content -->
      <mj-section css-class="mobile-padding">
        <!-- summary title -->
        <mj-column width="100%" padding-bottom="20px">
          <mj-text font-size="24px" font-weight="700" line-height="1.5" padding-bottom="4px"
            >{{ threshold }}% of Budget Reached</mj-text
          >
          <mj-text line-height="1.75">{{ alert_date }}</mj-text>
        </mj-column>

        <!-- summary table -->
        <mj-column width="100%" padding-bottom="40px">
          <mj-text line-height="1.75">Group:</mj-text>
          <mj-text font-size="16px" font-weight="700" line-height="1.5" padding-bottom="20px">{{
            group.name
          }}</mj-text>

          <mj-table css-class="table summary-table">
            <tr>
              <td class="group-first-column">Spending</td>
              <td style="font-weight: 700">{{ group.spending }}</td>
            </tr>
            <tr>
              <td class="group-first-column">Budget</td>
              <td style="font-weight: 700">{{ group.budget }}</td>
            </tr>
            <tr>
              <td class="group-first-column">Budget Period</td>
              <td>{{ group.period }}</td>
            </tr>
            <tr style="border-bottom: unset">
              <td class="group-first-column">Exceed Amount</td>
              <td>{{ group.exceed_amount }}</td>
            </tr>
          </mj-table>
        </mj-column>

        <!-- cost -->
        <mj-column width="100%">
          <mj-text font-size="16px" font-weight="700" line-height="1.5" padding-bottom="4px"
            >Resources Cost</mj-text
          >
          <mj-text line-height="1.5" color="#676767" padding-bottom="20px"
            >This section displays up to 10 resources with the highest spending</mj-text
          >

          <!-- {{#greaterThan (length gcp) 0}} -->
          <mj-image
            align="left"
            width="40px"
            padding-bottom="20px"
            src="http://cdn.mcauto-images-production.sendgrid.net/ff6786561925730a/90472c80-1b48-4f74-b896-824de998f707/41x41.png"
          />
          <mj-table css-class="table cost-table">
            <tr>
              <th style="width: 50%">GCP Projects</th>
              <th>Spending</th>
            </tr>

            <!-- {{#each gcp}} -->
            <tr>
              <td>{{ this.name }}</td>
              <td>{{ this.spending }}</td>
            </tr>
            <!-- {{/each}} -->
          </mj-table>
          <!-- {{/greaterThan}} -->

          <mj-spacer height="40px" />

          <!-- {{#greaterThan (length aws) 0}} -->
          <mj-image
            align="left"
            width="40px"
            padding-bottom="20px"
            src="http://cdn.mcauto-images-production.sendgrid.net/ff6786561925730a/1750afde-0103-42fe-b8a4-cb600d547569/41x41.png"
          />
          <mj-table css-class="table cost-table">
            <tr>
              <th style="width: 50%">AWS Accounts</th>
              <th>Spending</th>
            </tr>
            <!-- {{#each aws}} -->
            <tr>
              <td>{{ this.name }}</td>
              <td>{{ this.spending }}</td>
            </tr>
            <!-- {{/each}} -->
          </mj-table>
          <!-- {{/greaterThan}} -->
        </mj-column>
      </mj-section>

      <mj-section padding-bottom="20px">
        <!-- divider -->
        <mj-column width="100%" padding-bottom="20px"
          ><mj-image
            src="http://cdn.mcauto-images-production.sendgrid.net/ff6786561925730a/a3d76cd9-b338-4575-9c0d-f4cdf3bfb88e/1201x9.png"
          />
        </mj-column>

        <!-- action button -->
        <mj-column width="100%" padding="30px 0px">
          <mj-button
            width="130px"
            height="36px"
            border-radius="5px"
            background-color="#004FB0"
            color="white"
            font-size="16px"
            font-weight="700"
            href="{{detail_link}}"
          >
            <mj-text>View Details</mj-text>
          </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- footer -->
    <mj-include path="../common/footer.mjml" />
  </mj-body>
</mjml>
