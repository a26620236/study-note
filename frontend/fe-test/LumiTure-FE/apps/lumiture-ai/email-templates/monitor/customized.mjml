<mjml owa="desktop">
  <mj-head>
    <mj-title>LumiTure.ai monitor</mj-title>
    <mj-font
      name="Noto Sans TC"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />
    <!-- global style -->
    <mj-attributes>
      <mj-include path="../common/global-style.mjml" />
    </mj-attributes>
    <mj-style>
      .mobile-padding { padding: 40px ; } .table tr { border-bottom: 1px solid #E6E6E6;}
      .summary-table { border-top: 1px solid #B3B3B3; border-bottom: 1px solid #B3B3B3; }
      .summary-table td {line-height: 1.75; padding: 8px 0px} .budget-first-column { width:50%;
      padding-right: 8px; }.cost-table th{background-color: #F3F7FA ;padding: 4px 16px; text-align:
      left ;font-weight:unset;}.cost-table td{line-height: 1.75;padding:4px 16px} @media
      (max-width:450px) { .mobile-padding { padding: 40px 20px ; } } .progress_bar-wrap { position:
      relative; } .progress_bar { border-radius: 4px; } .progress_bar > p { border-radius: 4px;
      border-color: #00B5A6 !important; {{#greaterThan threshold 30}} border-color: #F4A938
      !important; {{/greaterThan}} {{#greaterThan threshold 100}} border-color: #FF403D !important;
      {{/greaterThan}} }
    </mj-style>
  </mj-head>

  <mj-body width="600px" background-color="#F3F7FA">
    <!-- logo -->
    <mj-include path="../common/header.mjml" />

    <mj-wrapper background-color="#FFFFFF">
      <!-- header image -->
      <mj-include path="../common/alert-header.mjml" />

      <!-- content -->
      <mj-section css-class="mobile-padding">
        <!-- summary title -->
        <mj-column width="100%">
          <mj-text font-size="24px" font-weight="700" line-height="1.5" padding-bottom="4px"
            >{{ threshold }}% of Budget Reached</mj-text
          >
        </mj-column>

        <!-- progress bar -->
        <mj-column width="100%" css-class="progress_bar-wrap">
          <mj-divider
            css-class="progress_bar"
            align="left"
            width="{{#greaterThan threshold 100}}100{{else}}{{threshold}}{{/greaterThan}}%"
            padding="0"
            border-width="16px"
            container-background-color="#E6E6E6"
          />
        </mj-column>

        <mj-column width="100%" padding-top="4px" padding-bottom="20px">
          <mj-text line-height="1.75">{{ alert_date }}</mj-text>
        </mj-column>

        <!-- summary table -->
        <mj-column width="100%" padding-bottom="40px">
          <mj-text line-height="1.75">Budget Name:</mj-text>
          <mj-text font-size="16px" font-weight="700" line-height="1.5">{{ budget.name }}</mj-text>
          <mj-text color="#676767" padding-bottom="20px">{{ budget.id }}</mj-text>

          <mj-table css-class="table summary-table">
            <tr>
              <td class="budget-first-column">Spending</td>
              <td>
                <p style="margin: 0; line-height: 1.5; font-weight: 700">{{ budget.spending }}</p>
                {{#if budget.credit}}
                <p style="margin: 0; line-height: 1.5; font-size: 12px">
                  Includes {{ budget.credit }} credit
                </p>
                {{/if}}
              </td>
            </tr>
            <tr>
              <td class="budget-first-column">Budget</td>
              <td style="font-weight: 700">{{ budget.budget }}</td>
            </tr>
            <tr>
              <td class="budget-first-column">Budget Period</td>
              <td>
                <p style="margin: 0; line-height: 1.5; font-weight: 700">{{ budget.period }}</p>
                <p style="margin: 0; line-height: 1.5; font-size: 12px">
                  Repeat {{#equals budget.period_type 0}}Monthly{{/equals
                  }}{{#equals
                  budget.period_type 1
                  }}Yearly{{/equals
                  }}{{#equals budget.period_type
                  2
                  }}Customized{{/equals}}
                </p>
              </td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <mj-section padding-bottom="20px">
        <!-- action button -->
        <mj-column width="100%" padding="30px 0px">
          <mj-button
            width="130px"
            height="36px"
            border-radius="5px"
            background-color="#004FB0"
            color="white"
            font-size="16px"
            font-weight="700"
            href="{{detail_link}}"
          >
            View Details
          </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- footer -->
    <mj-include path="../common/footer.mjml" />
  </mj-body>
</mjml>
