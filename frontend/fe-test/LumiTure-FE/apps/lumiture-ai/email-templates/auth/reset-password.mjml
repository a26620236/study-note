<mjml owa="desktop">
  <mj-head>
    <mj-title>LumiTure.ai Reset Password</mj-title>
    <mj-font
      name="Noto Sans TC"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />
    <!-- global style -->
    <mj-attributes>
      <mj-include path="../common/global-style.mjml" />
    </mj-attributes>
    <mj-style>
      .mobile-padding {
        padding: 40px;
      }
      .table tr {
        border-bottom: 1px solid #e6e6e6;
      }
      .summary-table {
        border-top: 1px solid #b3b3b3;
        border-bottom: 1px solid #b3b3b3;
      }
      .summary-table td {
        line-height: 1.75;
        padding: 8px 0px;
      }
      .group-first-column {
        width: 50%;
        padding-right: 8px;
      }
      .cost-table th {
        background-color: #f3f7fa;
        padding: 4px 16px;
        text-align: left;
        font-weight: unset;
      }
      .cost-table td {
        line-height: 1.75;
        padding: 4px 16px;
      }
      @media (max-width: 450px) {
        .mobile-padding {
          padding: 40px 20px;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body width="600px" background-color="#F3F7FA">
    <!-- logo -->
    <mj-include path="../common/header.mjml" />

    <!-- header image -->
    <mj-wrapper background-color="#FFFFFF">
      <mj-include path="../common/reset-password-header.mjml" />
    </mj-wrapper>

    <!-- content -->
    <mj-wrapper padding="0 40px" background-color="#FFFFFF">
      <mj-section padding="20px 0px">
        <!-- summary title -->
        <mj-column width="100%" padding-bottom="20px">
          <mj-text font-size="24px" font-weight="700" line-height="1.5" padding-bottom="4px"
            >Reset Password</mj-text
          >
        </mj-column>

        <!-- summary table -->
        <mj-column width="100%" padding-bottom="12px">
          <mj-text line-height="1.75">Hi {{ name }},</mj-text>
          <mj-text line-height="1.75" padding-top="32px"
            >We recently received a request to reset the password for your account. If you requested
            this change, please click the button below to reset password. If you did not request
            this change, you can safely disregard this email.</mj-text
          >
        </mj-column>
      </mj-section>

      <mj-hero
        padding="20px"
        background-width="500px"
        background-height="469px"
        background-url="http://cdn.mcauto-images-production.sendgrid.net/ff6786561925730a/3d5e52e0-796d-400b-a2e8-005417db756b/521x77.png"
      >
        <mj-button
          width="152px"
          height="36px"
          border-radius="5px"
          background-color="#004FB0"
          color="white"
          font-size="16px"
          font-weight="700"
          href="{{reset_link|e}}"
        >
          <mj-text>Reset Password</mj-text>
        </mj-button>
      </mj-hero>

      <mj-section padding="40px 0">
        <mj-column>
          <mj-text line-height="24.5px">
            You can also copy following link and paste it into the browser's address bar:</mj-text
          >
          <mj-text align="center" line-height="24.5px" color="#0B6DD7"
            ><a href="{{reset_link|e}}">{{ reset_link }}</a></mj-text
          >
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- footer -->
    <mj-include path="../common/footer.mjml" />
  </mj-body>
</mjml>
