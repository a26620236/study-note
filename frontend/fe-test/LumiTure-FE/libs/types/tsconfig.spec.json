{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"]
  },
  "include": [
    "vitest.config.ts",
    "vitest.config.mts",
    "test/**/*.test.ts",
    "test/**/*.spec.ts",
    "test/**/*.test.tsx",
    "test/**/*.spec.tsx",
    "src/**/*.d.ts"
  ]
}
